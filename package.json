{
  "name": "combined-mcp-inspector",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "node --test scripts/workspace-shape.test.mjs scripts/dev-runner.test.mjs scripts/dev-runner-lifecycle.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "inspect": "node --experimental-strip-types apps/web/inspector-cli.ts",
    "test:e2e": "playwright test",
    "verify:phase-0": "pnpm test && pnpm typecheck && pnpm verify:provenance && pnpm build && pnpm test:e2e",
    "verify:provenance": "node --experimental-strip-types scripts/verify-upstream-manifest.ts",
    "generate:provenance": "node --experimental-strip-types scripts/verify-upstream-manifest.ts --write"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
