{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "paths": { "@/client/*": ["./vendor/mcp-use/client/*"], "@combined/features": ["./src/features/InspectorFeatures.tsx"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "accounts/**/*.ts", "vite.config.ts", "inspector-server.ts", "inspector-cli.ts", "local-relay.test.ts", "inspector-cli.test.ts", "vendor-provenance.test.ts"]
}
