# Runtime settings for both application slots (loaded by Compose).
# Usage on the Ubuntu host:
#   install -m 600 deploy/.env.example deploy/.env
#   edit deploy/.env privately; replace every placeholder value
DATABASE_URL=postgresql://mcp_inspector@127.0.0.1:5432/mcp_inspector?sslmode=disable
PGPASSWORD='replace_me'
# 32 random bytes, base64. Generate once with: openssl rand -base64 32
# Back it up: losing it makes saved provider keys and chats unreadable.
MCP_INSPECTOR_ENCRYPTION_KEY='replace_me'
# Exact browser origin(s) served by the edge. Requests for other hosts get 403.
MCP_INSPECTOR_PUBLIC_ORIGINS=http://10.176.2.139:7000
MCP_INSPECTOR_ALLOWED_TARGETS=http://10.176.2.139:39064/mcp
# The PegaAI tunnel runs on this host; loopback keeps API keys off the LAN.
MCP_INSPECTOR_PEGA_AI_URL=http://127.0.0.1:4714
# Outbound proxy for public MCP servers (e.g. https://mcp.svelte.dev/mcp) when
# this host has no direct internet access. Use uppercase names. NO_PROXY must
# list every internal host the app calls (MCP targets, auth service, PegaAI).
#HTTP_PROXY=http://proxy.example:8080
#HTTPS_PROXY=http://proxy.example:8080
#NO_PROXY=127.0.0.1,localhost,::1,10.176.2.139,172.18.220.56
    