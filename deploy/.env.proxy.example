# Build-time proxy settings for the Docker image build (optional).
#
# Separate from deploy/.env on purpose: compose loads deploy/.env into the
# application containers at runtime, and these proxy values must stay out of
# the runtime environment. blue-green.sh forwards them to the image build as
# BuildKit secrets only.
#
# Usage on the Ubuntu host:
#   install -m 600 deploy/.env.proxy.example deploy/.env.proxy
#   edit deploy/.env.proxy privately with the approved proxy URL
#   ./deploy/blue-green.sh
#
# blue-green.sh loads this trusted shell file automatically for new image
# builds only. Keep mode 600. Do not put runtime/database settings here.
# When this file exists, it replaces inherited HTTP(S)/NO_PROXY settings.
# Comment out or delete a line to omit that setting from this profile.
# Without this file, exported shell proxy settings continue to work.
http_proxy='replace_me'
https_proxy='replace_me'
no_proxy='127.0.0.1,localhost,::1'
